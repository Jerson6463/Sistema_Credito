# Copiar a .env y ajustar valores
DJANGO_SECRET_KEY=cambiar-por-clave-segura-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# PostgreSQL
POSTGRES_DB=fairbet_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword

# Redis
REDIS_URL=redis://redis:6379/0

# Hosts DB (para docker-compose)
DB_HOST=db
DB_PORT=5432
